# Copy this file to `.env` and fill in values. Never commit the real .env.

# Where the frontend dev server runs
FRONTEND_ORIGIN=http://localhost:5173

# Uploads (optional; these are the defaults)
# UPLOAD_DIR=          (defaults to the system temp folder)
# MAX_UPLOAD_MB=5
# SESSION_TTL_MINUTES=60

# --- Which AI: auto (Claude if ANTHROPIC_API_KEY is set, else Gemini), claude or gemini ---
# AI_PROVIDER=auto

# --- Claude (Anthropic API) ---
# Create the key in the Claude Console, in the resume-refiner workspace.
# Paste it after the = sign in your real .env, never in this example file.
ANTHROPIC_API_KEY=
# CLAUDE_API_MODEL=claude-haiku-5-5
# Backup when the main model is overloaded or rate-limited. Empty = off.
# CLAUDE_API_FALLBACK_MODEL=claude-sonnet-5-5
# low (fastest, cheapest, default), medium or high
# CLAUDE_API_EFFORT=low
# CLAUDE_API_MAX_TOKENS=16000
# Only "true" if the company opts in to letting Anthropic train on API data
# (shown in the privacy notice, so it must match the real terms).
# CLAUDE_API_TRAINS_ON_DATA=false

# --- Gemini (Google) ---
# Get a key at https://aistudio.google.com (Get API key). Paste it after the
# = sign in your real .env, never in this example file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# "free" or "paid": shown to users in the privacy notice, so keep it accurate.
GEMINI_TIER=free
# Backup model, used automatically when the main one is busy. Empty = off.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# How much Gemini thinks before answering: low (fast, default), medium or high.
# GEMINI_THINKING_LEVEL=low
# Our hard limit for one AI request, retries included (seconds).
# AI_TOTAL_SECONDS=100
# AI_TIMEOUT_SECONDS=75

# --- Limits for a public server (defaults shown) ---
# UPLOADS_PER_IP_PER_HOUR=30
# ANALYSES_PER_SESSION=5
# ANALYSES_PER_IP_PER_HOUR=10
# ANALYSES_PER_DAY=200
# CLEANUP_INTERVAL_SECONDS=300

# The /docs API page: on by default locally, off in production.
# ENABLE_API_DOCS=true
